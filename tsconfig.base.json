{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@strat/content": ["packages/content/src/index.ts"],
      "@strat/content/*": ["packages/content/src/*"],
      "@strat/domain": ["packages/domain/src/index.ts"],
      "@strat/domain/*": ["packages/domain/src/*"],
      "@strat/ui": ["packages/ui/src/index.tsx"],
      "@strat/ui/*": ["packages/ui/src/*"],
      "@strat/config": ["packages/config/src/index.ts"],
      "@strat/config/*": ["packages/config/src/*"],
      "@app/*": ["apps/web/src/*"]
    }
  }
}
